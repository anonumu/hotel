# GitHub Linguist language overrides
# Documentation: https://github.com/github-linguist/linguist/blob/master/docs/overrides.md

# Ignore third-party Maven distribution completely
hotel-backend/maven/** linguist-vendored
hotel-backend/maven/** -linguist-detectable

# Ignore all scripts, batch files, and shell scripts
*.cmd linguist-vendored
*.cmd -linguist-detectable
*.bat linguist-vendored
*.bat -linguist-detectable
*.ps1 linguist-vendored
*.ps1 -linguist-detectable
*.sh linguist-vendored
*.sh -linguist-detectable

# Ignore all Python files completely
*.py linguist-vendored
*.py -linguist-detectable

# Ignore build artifacts
hotel-backend/target/** linguist-vendored
hotel-backend/target/** linguist-generated
hotel-backend/target/** -linguist-detectable

# Primary project languages
hotel-backend/src/main/java/** linguist-language=Java
hotel-frontend/js/** linguist-language=JavaScript

# Presentation assets and UI rendering
hotel-frontend/index.html linguist-vendored
hotel-frontend/index.html -linguist-detectable
hotel-frontend/style.css linguist-vendored
hotel-frontend/style.css -linguist-detectable
hotel-frontend/js/dashboard.js linguist-vendored
hotel-frontend/js/dashboard.js -linguist-detectable
hotel-frontend/js/modals.js linguist-vendored
hotel-frontend/js/modals.js -linguist-detectable
hotel-frontend/js/reports.js linguist-vendored
hotel-frontend/js/reports.js -linguist-detectable
